   compatible = "mediatek,mt6359-rtc";
   #address-cells = <1>;
   #size-cells = <1>;

   fg_init: fg_init {
    reg = <0 0x1>;
    bits = <0 8>;
   };
   fg_soc: fg_soc {
    reg = <1 0x1>;
    bits = <0 8>;
   };
