   reg = <0 0x1502f000 0 0x1000>;
   mediatek,smi = <&smi_common>;
   mediatek,larb-id = <6>;
   power-domains = <&scpsys 3>;
   clocks = <&imgsys 4>,
     <&imgsys 4>;
   clock-names = "apb", "smi";
  };
  vcu: vcu@16000000 {
   compatible = "mediatek-vcu";
   mediatek,vcuid = <0>;
   mediatek,vcuname = "vcu";
   reg = <0 0x16000000 0 0x40000>,
     <0 0x17020000 0 0x10000>,
     <0 0x19002000 0 0x1000>;
   iommus = <&iommu0 (((2) << 5) | (0))>;
   mboxes = <&gce 16 1 0>,
    <&gce 17 1 0>;

   gce-event-names = "vdec_pic_start",
    "vdec_decode_done",
    "vdec_pause",
    "vdec_dec_error",
    "vdec_mc_busy_overflow_timeout",
    "vdec_all_dram_req_done",
    "vdec_ini_fetch_rdy",
    "vdec_process_flag",
    "vdec_search_start_code_done",
    "vdec_ref_reorder_done",
    "vdec_wp_tble_done",
    "vdec_count_sram_clr_done",
    "venc_eof",
    "venc_cmdq_pause_done",
    "venc_mb_done",
    "venc_128B_cnt_done";

   gce-events = <&gce 416>,
    <&gce 417>,
    <&gce 418>,
    <&gce 419>,
    <&gce 420>,
    <&gce 421>,
    <&gce 422>,
    <&gce 423>,
    <&gce 424>,
    <&gce 425>,
    <&gce 426>,
    <&gce 427>,
    <&gce 289>,
    <&gce 290>,
    <&gce 292>,
    <&gce 293>;
  };

  vcodec_dec: vcodec@16000000 {
   compatible = "mediatek,mt6779-vcodec-dec";
   reg = <0 0x16000000 0 0x1000>,
     <0 0x16025000 0 0x1000>;
   interrupts = <0 324 8>;
   mediatek,vcu = <&vcu>;
   iommus = <&iommu0 (((2) << 5) | (0))>,
     <&iommu0 (((2) << 5) | (2))>,
     <&iommu0 (((2) << 5) | (7))>,
     <&iommu0 (((2) << 5) | (9))>,
     <&iommu0 (((2) << 5) | (3))>,
     <&iommu0 (((2) << 5) | (4))>,
     <&iommu0 (((2) << 5) | (5))>;
   operating-points-v2 = <&opp_table_vdec>;
   interconnects =
   <&mmqos
    (((0x4) << 16) | (((((2) << 5) | (0))) & 0xffff))
    &mmqos (((0x1) << 16) | ((0) & 0xffff))>,
   <&mmqos
    (((0x4) << 16) | (((((2) << 5) | (1))) & 0xffff))
    &mmqos (((0x1) << 16) | ((0) & 0xffff))>,
   <&mmqos
    (((0x4) << 16) | (((((2) << 5) | (2))) & 0xffff))
    &mmqos (((0x1) << 16) | ((0) & 0xffff))>,
   <&mmqos
    (((0x4) << 16) | (((((2) << 5) | (3))) & 0xffff))
    &mmqos (((0x1) << 16) | ((0) & 0xffff))>,
   <&mmqos
    (((0x4) << 16) | (((((2) << 5) | (4))) & 0xffff))
    &mmqos (((0x1) << 16) | ((0) & 0xffff))>,
   <&mmqos
    (((0x4) << 16) | (((((2) << 5) | (5))) & 0xffff))
    &mmqos (((0x1) << 16) | ((0) & 0xffff))>,
   <&mmqos
    (((0x4) << 16) | (((((2) << 5) | (6))) & 0xffff))
    &mmqos (((0x1) << 16) | ((0) & 0xffff))>,
   <&mmqos
    (((0x4) << 16) | (((((2) << 5) | (7))) & 0xffff))
    &mmqos (((0x1) << 16) | ((0) & 0xffff))>,
   <&mmqos
    (((0x4) << 16) | (((((2) << 5) | (8))) & 0xffff))
    &mmqos (((0x1) << 16) | ((0) & 0xffff))>,
   <&mmqos
    (((0x4) << 16) | (((((2) << 5) | (9))) & 0xffff))
    &mmqos (((0x1) << 16) | ((0) & 0xffff))>,
   <&mmqos
    (((0x4) << 16) | (((((2) << 5) | (10))) & 0xffff))
    &mmqos (((0x1) << 16) | ((0) & 0xffff))>,
   <&mmqos
    (((0x4) << 16) | (((((2) << 5) | (11))) & 0xffff))

    &mmqos (((0x1) << 16) | ((0) & 0xffff))>;
   interconnect-names =
     "MT_MM_M4U_VDEC_MC",
     "MT_MM_M4U_VDEC_UFO",
     "MT_MM_M4U_VDEC_PP",
     "MT_MM_M4U_VDEC_PRED_RD",
     "MT_MM_M4U_VDEC_PRED_WR",
     "MT_MM_M4U_VDEC_PPWRAP",
     "MT_MM_M4U_VDEC_TILE",
     "MT_MM_M4U_VDEC_VLD",
     "MT_MM_M4U_VDEC_VLD2",
     "MT_MM_M4U_VDEC_AVC_MV",
     "MT_MM_M4U_VDEC_UFO_ENC",
     "MT_MM_M4U_VDEC_RG_CTRL_DMA";
   clocks =
    <&mmsys 1>,
    <&mmsys 4>,
    <&mmsys 5>,
    <&vdecsys 1>;
   clock-names =
    "MT_MM_SMI_COMMON",
    "MT_MM_GALS_COMM0",
    "MT_MM_GALS_COMM1",
    "MT_CG_VDEC_VDEC";
   #clock-cells = <1>;
  };

  vdecsys: clock-controller@16000000 {
   compatible = "mediatek,mt6779-vdecsys", "syscon";
   reg = <0 0x16000000 0 0x1000>,
         <0 0x16025000 0 0x1000>;
   interrupts = <0 324 8>;
   #clock-cells = <1>;
  };

  larb2: larb@16010000 {
   compatible = "mediatek,mt6779-smi-larb";
   reg = <0 0x16010000 0 0x1000>;
   mediatek,smi = <&smi_common>;
   mediatek,larb-id = <2>;
   power-domains = <&scpsys 1>;
   clocks = <&vdecsys 1>,
     <&vdecsys 2>;
   clock-names = "apb", "smi";
  };

  vencsys: clock-controller@17000000 {
   compatible = "mediatek,mt6779-vencsys", "syscon";
   reg = <0 0x17000000 0 0x1000>,
         <0 0x17020000 0 0x1000>;
   interrupts = <0 270 8>;
   #clock-cells = <1>;
  };

  mfb@15010000 {
   compatible = "mediatek,mfb";
   reg = <0 0x15010000 0 0x1000>;
   interrupts = <0 294 8>;

   clocks = <&imgsys 2>;
   clock-names = "MFB_CLK_IMG_MFB";
  };

  wpe_a@15011000 {
   compatible = "mediatek,wpe_a";
   reg = <0 0x15011000 0 0x1000>;
   interrupts = <0 295 8>;

   clocks = <&imgsys 5>,
     <&imgsys 1>;
   clock-names = "WPE_CLK_IMG_LARB5", "WPE_CLK_IMG_WPE_A";
  };

  venc_gcon: venc_gcon@17000000 {
   compatible = "mediatek,venc_gcon", "syscon";
   reg = <0 0x17000000 0 0x1000>,
         <0 0x17020000 0 0x1000>;
   interrupts = <0 270 8>;
   mediatek,vcu = <&vcu>;
   iommus = <&iommu0 (((3) << 5) | (0))>,
     <&iommu0 (((3) << 5) | (1))>,
     <&iommu0 (((3) << 5) | (2))>,
     <&iommu0 (((3) << 5) | (3))>,
     <&iommu0 (((3) << 5) | (4))>,
     <&iommu0 (((3) << 5) | (5))>,
     <&iommu0 (((3) << 5) | (6))>,
     <&iommu0 (((3) << 5) | (13))>,
     <&iommu0 (((3) << 5) | (14))>,
     <&iommu0 (((3) << 5) | (15))>,
     <&iommu0 (((3) << 5) | (16))>,
     <&iommu0 (((3) << 5) | (17))>,
     <&iommu0 (((3) << 5) | (18))>;
   clocks =
     <&mmsys 1>,
     <&mmsys 4>,
     <&mmsys 5>,
     <&mmsys 3>,
     <&vdecsys 1>,
     <&vencsys 2>;
   clock-names =
    "MT_CG_SMI_COMMON",
    "MT_CG_GALS_COMM0",
    "MT_CG_GALS_COMM1",
    "CLK_MM_SMI_LARB1",
    "MT_CG_VDEC",
    "MT_CG_VENC";
   #clock-cells = <1>;
  };

  larb3: larb@17010000 {
   compatible = "mediatek,mt6779-smi-larb";
   reg = <0 0x17010000 0 0x1000>;
   mediatek,smi = <&smi_common>;
   mediatek,larb-id = <3>;
   power-domains = <&scpsys 5>;
   clocks = <&vencsys 2>,
     <&vencsys 3>;
   clock-names = "apb", "smi";
  };

  venc_jpg@17030000 {
   compatible = "mediatek,jpgenc";
   reg = <0 0x17030000 0 0x10000>;
   interrupts = <0 271 8>;
   iommus = <&iommu0 (((3) << 5) | (7))>,
    <&iommu0 (((3) << 5) | (8))>,
    <&iommu0 (((3) << 5) | (9))>,
    <&iommu0 (((3) << 5) | (10))>;
