   clock-names = "FD_CLK_IPE_FD";
   mboxes = <&gce 12 0 1>;
   gce-event-names = "fdvt_event_done";
   gce-events = <&gce 449>;
  };

  larb8: larb@1b00f000 {
   compatible = "mediatek,mt6779-smi-larb";
