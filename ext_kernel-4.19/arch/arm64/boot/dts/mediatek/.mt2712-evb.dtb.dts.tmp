  i2c3: i2c@11010000 {
   compatible = "mediatek,mt2712-i2c";
   reg = <0 0x11010000 0 0x90>,
         <0 0x11000300 0 0x80>;
   interrupts = <0 87 8>;
   clock-div = <4>;
   clocks = <&pericfg 23>,
     <&pericfg 11>;
   clock-names = "main",
          "dma";
   #address-cells = <1>;
   #size-cells = <0>;
