 uart0_pin_default: uart0_pin_uart_mode {
  pins_rx {
   pinmux = <(((117) << 8) | 1)>;
   input-enable;
   bias-pull-up;
  };
  pins_tx {
   pinmux = <(((120) << 8) | 1)>;
   output-high;
  };
 };

 uart0_pin_suspend: uart0_pin_gpio_mode {
  pins_rx {
   pinmux = <(((117) << 8) | 0)>;
   bias-pull-down;
  };
  pins_tx {
   pinmux = <(((120) << 8) | 0)>;
   output-low;
  };
 };

 uart4_pin_default: uart4_pin_uart_mode {
  pins_rx {
   pinmux = <(((97) << 8) | 1)>;
   input-enable;
   bias-pull-up;
  };
  pins_tx {
   pinmux = <(((99) << 8) | 1)>;
   output-high;
  };
 };

 uart4_pin_suspend: uart4_pin_gpio_mode {
  pins_rx {
   pinmux = <(((97) << 8) | 0)>;
   bias-pull-down;
  };
  pins_tx {
   pinmux = <(((99) << 8) | 0)>;
   output-low;
  };
 };

 usb0_id_pins_float: usb0_iddig {
  pins_iddig {
   pinmux = <(((12) << 8) | 1)>;
   bias-pull-up;
  };
 };

 usb1_id_pins_float: usb1_iddig {
  pins_iddig {
   pinmux = <(((14) << 8) | 1)>;
   bias-pull-up;
  };
 };

 vcpu_vsel_pin: vcpu_vsel {
  pins_cmd_dat {
   pinmux = <(((123) << 8) | 0)>;
   output-high;
  };
 };

 vcore_vsel_pin: vcore_vsel {
  pins_cmd_dat {
   pinmux = <(((126) << 8) | 3)>;
  };
 };

 ts_int_default: tsintdefault {
  pins_cmd_dat {
   pinmux = <(((2) << 8) | 1)>;
   input-enable;
   bias-disable;
  };
 };

 ts_int_output_low: tsintoutlow {
  pins_cmd_dat {
   pinmux = <(((2) << 8) | 0)>;
   input-disable;
   output-low;
  };
 };

 ts_int_output_high: tsintouthigh {
  pins_cmd_dat {
   pinmux = <(((2) << 8) | 0)>;
   input-disable;
   output-high;
  };
 };

 ts_int_input: tsintinput {
  pins_cmd_dat {
   pinmux = <(((2) << 8) | 1)>;
   input-enable;
   bias-disable;
  };
 };
};

&pwm0 {
 pinctrl-names = "default";
 pinctrl-0 = <&disp_pwm0_pins>;
 status = "okay";
};

&rdma1 {
 port {
  next1: endpoint {
   remote-endpoint = <&dsi2_out>;
  };
 };
};

&spi0 {
 pinctrl-names = "default","sleep";
 pinctrl-0 = <&spi_pins_0>;
 pinctrl-1 = <&spi_pins_0_sleep>;
 status = "disable";

 spidev0: spi@0 {
  compatible = "linux,spidev";
  reg = <0>;
  spi-max-frequency = <1000000>;
 };
};

&spis1 {
 pinctrl-names = "default";
 pinctrl-0 = <&spi_pins_1>;
 status = "okay";

 slave {
  compatible = "spi-slave-mt27xx-test";
 };
};

&spi2 {
 pinctrl-names = "default","sleep";
 pinctrl-0 = <&spi_pins_2>;
 pinctrl-1 = <&spi_pins_2_sleep>;
 status = "disable";

 spidev2: spi@0 {
  compatible = "linux,spidev";
  reg = <0>;
  spi-max-frequency = <1000000>;
 };
};

&spi3 {
 pinctrl-names = "default","sleep";
 pinctrl-0 = <&spi_pins_3>;
 pinctrl-1 = <&spi_pins_3_sleep>;
 status = "disable";

 spidev3: spi@0 {
  compatible = "linux,spidev";
  reg = <0>;
  spi-max-frequency = <1000000>;
 };
};

&spi4 {
 pinctrl-names = "default","sleep";
 pinctrl-0 = <&spi_pins_4>;
 pinctrl-1 = <&spi_pins_4_sleep>;
 status = "okay";

 spidev4: spi@0 {
  compatible = "spi-mt65xx-dev";
  reg = <0>;
  spi-max-frequency = <1000000>;
 };

};

&spi5 {
 pinctrl-names = "default","sleep";
 pinctrl-0 = <&spi_pins_5>;
 pinctrl-1 = <&spi_pins_5_sleep>;
 status = "disable";

 spidev5: spi@0 {
  compatible = "linux,spidev";
  reg = <0>;
  spi-max-frequency = <1000000>;
 };
};

&ssusb {
 vbus-supply = <&usb_p0_vbus>;
 extcon = <&extcon_usb>;
 dr_mode = "otg";
 wakeup-source;
 mediatek,u3p-dis-msk = <0x1>;
 pinctrl-names = "default";
 pinctrl-0 = <&usb0_id_pins_float>;
 status = "okay";
};

&ssusb1 {
 vbus-supply = <&usb_p1_vbus>;
 dr_mode = "otg";
 enable-manual-drd;
 wakeup-source;
 status = "okay";
};

&uart0 {
 pinctrl-names = "default", "sleep";
 pinctrl-0 = <&uart0_pin_default>;
 pinctrl-1 = <&uart0_pin_suspend>;
 status = "okay";
};

&uart4 {
 pinctrl-names = "default", "sleep";
 pinctrl-0 = <&uart4_pin_default>;
 pinctrl-1 = <&uart4_pin_suspend>;
 status = "okay";
};

&usb_host0 {
 status = "okay";
};

&usb_host1 {
 status = "okay";
};
# 9 "arch/arm64/boot/dts/mediatek/auto2712p1v1-ivi-nand-boot.dts" 2

/ {
 chosen {
  bootargs = "console=ttyS0,921600n1 ubi.mtd=4 rootfstype=ubifs root=ubi0_0 ubi.mtd=5 rootwait earlycon=uart8250,mmio32,0x11002000";
 };

 memory@40000000 {
  device_type = "memory";
  reg = <0 0x40000000 0 0x40000000>;
 };
};

&bch {
 status = "okay";
};

&it6151_5c {
 resolution-index = <2>;
};

&nandc {
 pinctrl-names = "default";
 pinctrl-0 = <&nand_pins_default>;
 status = "okay";
 nand@0 {
  reg = <0>;
  nand-on-flash-bbt;
  nand-ecc-mode = "hw";
 };
};
