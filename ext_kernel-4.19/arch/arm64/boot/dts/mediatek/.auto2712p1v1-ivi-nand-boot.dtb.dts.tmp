 it6151_5d: it6151@5d {
  compatible = "ite,it6151";
  reg = <0x5d>;
  pinctrl-names = "default";
  pinctrl-0 = <&it6151_i2c3_5d_reset_pin>;
  reset-gpios = <&pio 153 0>;
  resolution-index = <0>;
