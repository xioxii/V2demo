      <&clkaud_ext_i_2>,
      <&clk26m>,
      <&topckgen 7>,
      <&topckgen 17>,
      <&topckgen 34>,
      <&topckgen 32>,
      <&topckgen 14>,
      <&topckgen 15>,
      <&topckgen 43>,
      <&topckgen 44>,
      <&topckgen 45>,
      <&topckgen 46>,
      <&topckgen 47>,
      <&topckgen 48>,
      <&topckgen 49>,
      <&topckgen 50>,
      <&topckgen 51>,
      <&topckgen 52>,
      <&topckgen 143>,
      <&topckgen 31>,
      <&topckgen 30>,
      <&topckgen 13>;

    clock-names = "aud_intbus_sel",
           "aud_apll1_sel",
           "aud_apll2_sel",
           "a1sys_hp_sel",
           "a2sys_hp_sel",
           "apll_sel",
           "apll2_sel",
           "i2so1_sel",
           "i2so2_sel",
           "i2so3_sel",
