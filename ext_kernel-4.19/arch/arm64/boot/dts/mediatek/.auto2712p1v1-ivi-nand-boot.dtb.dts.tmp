     <(((205) << 8) | 1)>,

     <(((207) << 8) | 1)>;
   drive-strength = <8>;
  };

  wake_n_pull_up {
   pinmux = <(((206) << 8) | 1)>;
   drive-strength = <8>;
   input-enable;
   bias-pull-up;
  };
 };

 state_wakeup_eint_as_int: eint@137 {
  pins_cmd_dat {
   pinmux = <(((137) << 8) | 0)>;
   bias-pull-up = <101>;
  };
 };

