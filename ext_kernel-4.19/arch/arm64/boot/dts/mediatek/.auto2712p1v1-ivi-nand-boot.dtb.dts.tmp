   afe: audio-controller {
    compatible = "mediatek,mt2712-audio";
    interrupts = <0 242 8>,
          <0 142 8>;
    tdm-mode = <2>;
    i2s-mode = <1 1 0>;
    i2s-out-coclk = <1 1 1>;
    tdm-in-lrck-setting = <0 0>;
    early-clk-mode = <0>;
